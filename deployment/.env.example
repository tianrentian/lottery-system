# 复制为 deployment/.env 后填写真实值，不要把 .env 提交到 Git。
MYSQL_ROOT_PASSWORD=change-me-mysql-root
LOTTERY_DB_USERNAME=lottery_user
LOTTERY_DB_PASSWORD=change-me-lottery-db
GOBANG_DB_USERNAME=gobang_user
GOBANG_DB_PASSWORD=change-me-gobang-db

RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=change-me-rabbitmq

# real 会调用 DeepSeek；本地或演示环境可改为 mock。
AI_PLANNER_MODE=real
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-v4-flash

# 公网映射端口（服务器安全组只需开放这两个业务端口）
LOTTERY_PORT=8080
GOBANG_PORT=8081

# 可选配置
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_AUTH_CODE=
DINGTALK_WEBHOOK_URL=
