# Copy this file to .env on the deployment machine and fill real values there.
# Never commit the real .env file.

MYSQL_PASSWORD=your_mysql_password
REDIS_HOST=localhost
REDIS_PORT=8888
RABBITMQ_HOST=localhost
RABBITMQ_PASSWORD=admin
MAIL_AUTH_CODE=your_mail_auth_code
DEEPSEEK_API_KEY=your_deepseek_api_key
DINGTALK_WEBHOOK_URL=your_dingtalk_webhook_url

# Optional SMS provider credentials, only needed when SMS login is enabled.
SMS_ACCESS_KEY_ID=your_sms_access_key_id
SMS_ACCESS_KEY_SECRET=your_sms_access_key_secret
